# --- OpenRouter (LLM sentiment) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- SerpApi (Google News) ---
SERPAPI_API_KEY=

# --- Optional tuning ---
CACHE_TTL_MINUTES=60
MAX_ARTICLES_PER_STOCK=10
NEWS_WINDOW_DAYS=7
NEXT_PUBLIC_MAX_WATCHLIST_SIZE=25

# Set to 1 to serve canned sample results (no API keys needed)
DEMO_MODE=
